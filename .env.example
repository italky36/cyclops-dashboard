# Cyclops Dashboard Environment Variables
# Скопируйте этот файл в .env.local и заполните значениями

# ============================================
# БЕЗОПАСНОСТЬ КЛЮЧЕЙ
# ============================================

# Мастер-пароль для шифрования ключей (ОБЯЗАТЕЛЬНО в production!)
# Сгенерируйте случайный: openssl rand -base64 32
KEYS_MASTER_PASSWORD="your-secure-master-password-here"

# Путь к директории хранения зашифрованных ключей
KEYS_STORAGE_PATH="./.keys"

# ============================================
# АВТОРИЗАЦИЯ
# ============================================

# Секрет для подписи сессий (генерация: openssl rand -base64 32)
AUTH_SECRET="change-me"

# Путь к файлу SQLite базы
SQLITE_PATH="./data/cyclops.db"

# ============================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ============================================

# URL приложения (для CORS и CSP)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Режим разработки (development | production)
NODE_ENV="development"

# ============================================
# CYCLOPS API - ПУБЛИЧНЫЕ КЛЮЧИ ШИФРОВАНИЯ КАРТ
# ============================================

# Публичные RSA ключи Cyclops для шифрования номеров карт
# Эти ключи должны быть получены от технической поддержки Точка Банк
# Формат: PEM (-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----)
#
# Слой pre (тестовое окружение)
# CYCLOPS_CARD_PUBLIC_KEY_PRE="-----BEGIN PUBLIC KEY-----
# MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA...
# -----END PUBLIC KEY-----"
#
# Слой prod (продакшен)
# CYCLOPS_CARD_PUBLIC_KEY_PROD="-----BEGIN PUBLIC KEY-----
# MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA...
# -----END PUBLIC KEY-----"

# Слой по умолчанию для шифрования (опционально, по умолчанию 'pre')
# CYCLOPS_DEFAULT_LAYER="pre"

# ============================================
# VENDISTA API (Торговые автоматы)
# ============================================

# API ключ Vendista (ОБЯЗАТЕЛЬНО для интеграции с Vendista)
VENDISTA_API_KEY=""

# Базовый URL Vendista API (опционально, по умолчанию https://api.vendista.ru:99)
# VENDISTA_BASE_URL="https://api.vendista.ru:99"

# ============================================
# ПРИМЕЧАНИЯ
# ============================================
#
# ПРИВАТНЫЕ КЛЮЧИ RSA (для подписи запросов):
# - Загружаются через веб-интерфейс /settings
# - Шифруются и хранятся в .keys/ директории
# - Никогда не коммитьте директорию .keys в репозиторий!
#
# ПУБЛИЧНЫЕ КЛЮЧИ (для шифрования данных карт):
# - Получите от технической поддержки Точка Банк
# - Добавьте в переменные CYCLOPS_CARD_PUBLIC_KEY_PRE и CYCLOPS_CARD_PUBLIC_KEY_PROD
# - Необходимы для создания сделок с типом получателя "payment_contract_to_card"
